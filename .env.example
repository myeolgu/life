# Supabase 프로젝트 설정값 (supabase.com 대시보드 > Project Settings > API 에서 확인)
# 이 파일을 복사해서 .env로 만들고 실제 값을 채워 넣으세요. .env는 git에 커밋되지 않습니다.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 아래 둘은 VITE_ 접두사가 없어야 함 (붙이면 클라이언트 번들에 노출됨).
# 스키마 변경(테이블/정책 추가 등)을 Claude가 Management API로 직접 실행할 때만 사용.
# 발급: https://supabase.com/dashboard/account/tokens
SUPABASE_PROJECT_REF=xxxxxxxxxxxx
SUPABASE_MANAGEMENT_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
